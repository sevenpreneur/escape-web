# Supabase project URL and public anon key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — used by one-off scripts in scripts/
DATABASE_URL=
